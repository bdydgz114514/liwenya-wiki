---
interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  href?: string;
  linkLabel?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, desc, href, linkLabel = '查看全部', align = 'left' } = Astro.props;
---

<div
  class:list={[
    'reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between',
    align === 'center' && 'md:flex-col md:items-center md:text-center',
  ]}
>
  <div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 class="h-section mt-4 balance">{title}</h2>
    {desc && <p class="lede mt-4">{desc}</p>}
  </div>
  {href && (
    <a href={href} class="btn btn-ghost btn-sm shrink-0">
      {linkLabel}
      <span class="card-arrow">→</span>
    </a>
  )}
</div>
