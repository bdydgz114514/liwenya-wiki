---
import { resolveSources, type SourceRef } from '../lib/data';

interface Props {
  sources?: SourceRef[];
  title?: string;
  compact?: boolean;
}
const { sources, title = '来源与出处', compact = false } = Astro.props;
const list = resolveSources(sources);
---

<section class:list={['card card-flat card-pad', compact && 'bg-transparent']}>
  <h2 class="field-label">{title}</h2>
  {list.length === 0 ? (
    <p class="mt-3 text-sm text-muted">该条目暂未标注来源，内容等待流水线补充溯源信息。</p>
  ) : (
    <ul class="mt-4 space-y-2.5 text-sm">
      {list.map((s) => (
        <li class="flex items-start gap-2">
          <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
          {s.href ? (
            <a
              href={s.href}
              class="link-underline min-w-0 break-all text-muted hover:text-white"
              rel={s.external ? 'noopener nofollow' : undefined}
              target={s.external ? '_blank' : undefined}
            >
              {s.label}{s.external && ' ↗'}
            </a>
          ) : (
            <span class="min-w-0 break-all text-muted">{s.label}</span>
          )}
          {s.note && <span class="dim text-xs">{s.note}</span>}
        </li>
      ))}
    </ul>
  )}
</section>
