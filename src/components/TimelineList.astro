---
import { formatDateLabel, eventMonth, type EventItem, personName, resolveSources, getVideo, videoTitle } from '../lib/data';

interface Props {
  items: EventItem[];
  showYear?: boolean;
}
const { items, showYear = false } = Astro.props;
---

<ol class="timeline">
  {items.map((e) => {
    const refs = e.videoRefs ?? [];
    const videos = refs.map((id) => getVideo(id)).filter(Boolean);
    // 来源里指向同一批视频的链接不再重复展示
    const sources = resolveSources(e.sources).filter((s) => !s.href || !refs.some((id) => s.href === '/videos/' + id));
    return (
      <li class="timeline-item reveal" id={e.id}>
        <div class="flex flex-wrap items-center gap-3">
          <span class="timeline-date">{showYear ? formatDateLabel(e.date) : eventMonth(e.date) || formatDateLabel(e.date)}</span>
          {(e.people ?? []).length > 0 && (
            <span class="flex flex-wrap gap-1.5">
              {(e.people ?? []).map((p) => (
                <a href={'/people/' + p} class="chip chip-btn">{personName(p)}</a>
              ))}
            </span>
          )}
        </div>

        <h3 class="mt-3 text-lg font-bold tracking-tight md:text-xl">{e.title || '未命名事件'}</h3>
        {e.summary && <p class="mt-2 max-w-3xl text-sm leading-7 text-muted">{e.summary}</p>}

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          {videos.slice(0, 6).map((v) => (
            <a href={'/videos/' + v!.id} class="chip chip-btn" title={videoTitle(v!)}>
              视频 {v!.id}
            </a>
          ))}
          {sources.slice(0, 3).map((s) =>
            s.href ? (
              <a
                href={s.href}
                class="chip"
                rel={s.external ? 'noopener nofollow' : undefined}
                target={s.external ? '_blank' : undefined}
              >
                {s.label}{s.external && ' ↗'}
              </a>
            ) : (
              <span class="chip">{s.label}</span>
            )
          )}
        </div>
      </li>
    );
  })}
</ol>
