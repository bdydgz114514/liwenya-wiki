---
// 电影板块：内容尚未公开，只给占位页。
// 影片物料（trailer / 三段在线版）已从站点下架，页面不再渲染任何 <video>，
// 避免出现指向不存在文件的 404 播放器。数据与文案仍保留在 src/data/film.json，
// 将来要放出来时，把本页改回读取 film.json 的完整版即可。
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
---

<BaseLayout
  title="电影"
  description="李文亚 Wiki · 电影板块筹备中，敬请期待。"
  searchType="电影"
>
  <nav class="shell mono text-xs text-muted-dim" aria-label="面包屑">
    <a href="/novel" class="hover:text-white">长篇传记</a>
    <span class="mx-2">/</span>
    <span class="text-muted">电影</span>
  </nav>

  <ComingSoon
    eyebrow="Film"
    title="敬请期待"
    desc="电影板块正在筹备中。相关物料暂不公开，后续进展会在本站与「长篇传记」页同步。"
    links={[
      { href: '/novel', label: '先看长篇传记（30 章）' },
      { href: '/videos', label: '视频库' },
      { href: '/theories', label: '理论体系' },
    ]}
  />
</BaseLayout>
