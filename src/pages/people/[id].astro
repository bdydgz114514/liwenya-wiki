---
import EmptyState from '../../components/EmptyState.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SourceList from '../../components/SourceList.astro';
import VideoCard from '../../components/VideoCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entityHref,
  eventsOfPerson,
  formatNumber,
  getPerson,
  graphNeighbors,
  people,
  personName,
  typeLabel,
  videosOfPerson,
} from '../../lib/data';

export function getStaticPaths() {
  return people.map((p) => ({ params: { id: p.id }, props: { person: p } }));
}

const { person } = Astro.props;
const p = getPerson(person.id) ?? person;
const videos = videosOfPerson(p.id);
const events = eventsOfPerson(p.id);
const related = graphNeighbors(p.id);
---

<BaseLayout
  title={p.name ?? p.id}
  description={(p.summary ?? '人物条目').slice(0, 120)}
  searchType="人物"
>
  <section class="hero-surface">
    <div class="shell pt-[calc(var(--header-h)+3rem)] pb-12 md:pt-[calc(var(--header-h)+4rem)]">
      <nav class="mono text-xs text-muted-dim" aria-label="面包屑">
        <a href="/people" class="hover:text-white">人物志</a>
        <span class="mx-2">/</span>
        <span class="text-muted">{p.id}</span>
      </nav>
      <div class="reveal mt-6 max-w-4xl">
        <span class="eyebrow">{p.type ?? '人物条目'}</span>
        <h1 class="display-sm mt-5 text-shadow-hero">{p.name ?? p.id}</h1>
        {(p.aliases ?? []).length > 0 && (
          <p class="mt-5 text-sm text-muted">别名：{(p.aliases ?? []).join(' · ')}</p>
        )}
        <div class="mt-6 flex flex-wrap gap-1.5">
          {(p.tags ?? []).map((t) => <span class="chip">{t}</span>)}
          <span class="chip chip-accent">{formatNumber(videos.length)} 个关联视频</span>
        </div>
        <div class="accent-rule mt-8"></div>
      </div>
    </div>
  </section>

  <div class="shell section grid gap-10 lg:grid-cols-[1.5fr_0.75fr]">
    <div class="space-y-10">
      <section class="reveal">
        <h2 class="field-label">条目摘要</h2>
        {p.summary ? (
          <div class="prose-block mt-4 text-base leading-8">
            <p>{p.summary}</p>
          </div>
        ) : (
          <div class="mt-4"><EmptyState title="暂无摘要" desc="该条目在数据集中未提供 summary 字段。" /></div>
        )}
      </section>

      <section>
        <SectionHeading eyebrow="Videos" title="关联视频" desc="出现在 videoRefs 或场景卡人物标注中的视频。" />
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {videos.slice(0, 8).map((v) => <VideoCard video={v} compact />)}
        </div>
        {videos.length === 0 && (
          <div class="mt-6"><EmptyState title="暂无关联视频" desc="videoRefs 为空或引用的视频 id 不在 videos.json 中。" /></div>
        )}
      </section>

      {events.length > 0 && (
        <section>
          <SectionHeading eyebrow="Events" title="相关事件" />
          <ul class="mt-6 space-y-3">
            {events.map((e) => (
              <li class="card card-flat card-pad reveal">
                <span class="mono text-xs text-accent-bright">{e.date ?? '时间待考'}</span>
                <h3 class="mt-2 text-base font-bold">{e.title ?? '未命名事件'}</h3>
                {e.summary && <p class="mt-2 text-sm leading-7 text-muted">{e.summary}</p>}
                <a href={'/timeline#' + e.id} class="mono mt-3 inline-block text-xs text-muted hover:text-white">在年表中查看 →</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-5">
      <div class="sticky-aside space-y-5">
        <SourceList sources={p.sources} />

        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">关系图</h2>
          {related.length === 0 ? (
            <p class="mt-3 text-sm text-muted">graph.json 中没有与该条目相连的边。</p>
          ) : (
            <ul class="mt-4 space-y-3 text-sm">
              {related.map((r) => (
                <li class="flex items-start justify-between gap-3">
                  <a href={entityHref(r.node.type, r.node.id)} class="link-underline text-[#d7dae1] hover:text-white">
                    {r.node.label ?? r.node.id}
                  </a>
                  <span class="chip shrink-0">{typeLabel[r.node.type ?? ''] ?? r.node.type ?? '关联'} · {r.type}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">引用本条目</h2>
          <p class="mono mt-3 text-xs leading-6 text-muted">
            {p.name ?? p.id}．李文亚 Wiki．{Astro.site ? new URL('/people/' + p.id, Astro.site).href : '/people/' + p.id}
          </p>
          <p class="mt-3 text-xs text-muted-dim">引用时请一并保留条目中的视频编号与时间码，以便回溯。</p>
        </div>

        {people.length > 1 && (
          <div class="card card-flat card-pad reveal">
            <h2 class="field-label">其他人物</h2>
            <ul class="mt-4 space-y-2 text-sm">
              {people.filter((x) => x.id !== p.id).slice(0, 6).map((x) => (
                <li><a href={'/people/' + x.id} class="text-muted hover:text-white">{personName(x.id)}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
