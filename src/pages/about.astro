---
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, stats, updatedAt } from '../lib/data';

const principles = [
  {
    title: '可溯源',
    desc: '每条结论都携带视频编号与时间码。没有出处的表述不进入条目，宁缺毋滥。',
  },
  {
    title: '中立转述',
    desc: '视频中的指控、理论与自述按「当事人陈述」记录，不作事实认定，不使用嘲讽性措辞。',
  },
  {
    title: '机器理解 + 人工规则',
    desc: 'ASR / VLM / OCR 结果分层存储，融合层只做归一化与对齐，不臆造原文中不存在的信息。',
  },
  {
    title: '隐私优先',
    desc: '不收录住址、联系方式、证件、健康与医疗等私密信息；不鼓励对任何当事人的现实骚扰。',
  },
];

const privacy = [
  { title: '不收录的内容', desc: '真实住址、电话、身份证件、车牌、病历与用药记录、家庭成员的非公开信息、未公开的聊天记录等。' },
  { title: '自动化处理', desc: '站点为纯静态页面，不含用户账号、评论、埋点或第三方统计脚本；不会采集访问者数据。' },
  { title: '搜索', desc: '站内搜索基于构建期生成的本地索引（Pagefind / JSON 兜底），查询词不会离开浏览器。' },
  { title: '删除请求', desc: '当事人或其代理人如认为某条内容侵犯权益，可通过来源页所列渠道提出，我们会在核实后尽快隐藏或删除。' },
];

const stack = [
  { key: '框架', val: 'Astro（静态输出，零客户端框架）' },
  { key: '样式', val: 'Tailwind CSS v4 + 自定义设计令牌' },
  { key: '搜索', val: 'Pagefind（构建后索引）+ JSON 兜底搜索' },
  { key: '数据', val: 'src/data/*.json（由知识库流水线导出）' },
  { key: '交互', val: 'IntersectionObserver 滚动出现动画，无第三方 UI 库' },
  { key: '字体', val: '系统字体栈（system-ui / PingFang SC / Microsoft YaHei…）' },
];
---

<BaseLayout title="关于本站" description="李文亚 Wiki 的方法论、数据来源、免责声明与隐私声明。">
  <PageHero
    eyebrow="About"
    title="关于本站"
    desc="本站把 1193 个归档视频（168.6 小时）的多模态理解结果整理成可检索、可溯源的百科条目。它是一个档案整理项目，不是粉丝应援站，也不是对任何主张的背书。"
    meta={[stats.videos + ' 个视频', stats.hours + ' 小时', '数据版本 ' + updatedAt]}
  />

  <div class="shell section space-y-16">
    <section>
      <SectionHeading eyebrow="Method" title="我们怎么做的" desc="归档视频经本地流水线做语音识别、画面理解与文字识别，再对齐成场景卡，最后汇总为条目。" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {principles.map((p, i) => (
          <div class="card card-pad reveal">
            <span class="mono text-xs tracking-[0.3em] text-muted-dim">0{i + 1}</span>
            <h3 class="mt-4 text-lg font-extrabold tracking-tight">{p.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr]">
      <div>
        <SectionHeading eyebrow="Disclaimer" title="免责声明" />
        <div class="mt-8 card card-flat card-pad reveal prose-block text-sm leading-7">
          <p>1. 本站为爱好者自发的<strong>非官方、非营利</strong>档案项目，与李文亚本人、其视频中提及的任何人物与机构均无隶属关系。</p>
          <p>2. 视频中的理论、指控与自述均为<strong>当事人单方陈述</strong>，本站仅作转述与整理，不作事实认定，也不构成任何形式的建议。</p>
          <p>3. 自动理解结果（ASR 转写、VLM 画面描述、OCR 文字）可能存在识别误差；发现错误时以原始视频为准。</p>
          <p>4. 涉及医疗、健康、法律等专业领域的内容，请咨询相应专业机构；请勿依据本站内容做出任何决策。</p>
          <p>5. 本站不提供原始视频文件的下载或再分发，仅展示结构化理解结果与元数据。</p>
          <p>6. 本站不鼓励、也不容忍对任何当事人的现实骚扰、人肉搜索或恶意行为。</p>
        </div>
      </div>

      <aside class="space-y-5">
        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">技术栈</h2>
          <div class="mt-3">
            {stack.map((s) => (
              <div class="spec-row">
                <span class="spec-key">{s.key}</span>
                <span class="spec-val text-xs">{s.val}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">数据版本</h2>
          <p class="mono mt-3 text-sm text-muted">{updatedAt}</p>
          <p class="mt-3 text-xs text-muted-dim">
            站点构建时只读取 src/data/*.json，不访问网络、不查询数据库；替换数据后重新构建即可更新全站。
          </p>
          <a href="/sources" class="btn btn-ghost btn-sm mt-5 w-full">来源与采集说明</a>
        </div>
      </aside>
    </section>

    <section>
      <SectionHeading
        eyebrow="Privacy"
        title="隐私声明"
        desc="本站以「不伤害当事人」为最高优先级：只整理已公开的视频内容，不触碰私密信息。"
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {privacy.map((p) => (
          <div class="card card-pad reveal">
            <h3 class="text-base font-bold">{p.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal rounded-[16px] border border-line bg-ink-850 p-8 md:p-10">
      <span class="eyebrow">Contact</span>
      <h2 class="h-section mt-4">纠错与反馈</h2>
      <p class="lede mt-4 max-w-3xl">
        发现事实错误、缺少出处或涉及隐私的内容，请通过来源页所列的外部社区渠道提出。我们优先处理隐私相关请求，并在核实后尽快修正。
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/sources" class="btn btn-primary">来源与参考</a>
        <a href="/videos" class="btn btn-ghost">浏览视频库</a>
      </div>
    </section>
  </div>
</BaseLayout>
