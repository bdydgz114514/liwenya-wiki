---
import EmptyState from '../../components/EmptyState.astro';
import SourceList from '../../components/SourceList.astro';
import TheoryTextbook from '../../components/TheoryTextbook.astro';
import VideoCard from '../../components/VideoCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entityHref,
  formatTimecode,
  getVideo,
  graphNeighbors,
  resolveSources,
  textbookOfTheory,
  theories,
  theoryById,
  typeLabel,
  videoById,
  videoTitle,
} from '../../lib/data';

export function getStaticPaths() {
  return theories.map((t) => ({ params: { id: t.id }, props: { theory: t } }));
}

const { theory } = Astro.props;
const t = theoryById.get(theory.id) ?? theory;
const evidence = (t.evidence ?? []).filter((e) => e && e.videoId);
const videos = [...new Set(evidence.map((e) => e.videoId!))].map((id) => getVideo(id)).filter(Boolean);
const related = graphNeighbors(t.id);
const textbook = textbookOfTheory(t.id);
---

<BaseLayout title={t.name ?? t.id} description={(t.summary ?? '理论条目').slice(0, 120)} searchType="理论">
  <section class="hero-surface">
    <div class="shell pt-[calc(var(--header-h)+3rem)] pb-12 md:pt-[calc(var(--header-h)+4rem)]">
      <nav class="mono text-xs text-muted-dim" aria-label="面包屑">
        <a href="/theories" class="hover:text-white">理论体系</a>
        <span class="mx-2">/</span>
        <span class="text-muted">{t.id}</span>
      </nav>
      <div class="reveal mt-6 max-w-4xl">
        <span class="eyebrow">Theory</span>
        <h1 class="display-sm mt-5 text-shadow-hero">{t.name ?? t.id}</h1>
        {(t.aliases ?? []).length > 0 && <p class="mt-5 text-sm text-muted">别名：{(t.aliases ?? []).join(' · ')}</p>}
        <div class="mt-6 flex flex-wrap gap-1.5">
          <span class="chip chip-accent">{evidence.length} 处证据锚点</span>
          <span class="chip">{videos.length} 个视频</span>
          {textbook && <span class="chip">教科书级讲解</span>}
        </div>
        <div class="accent-rule mt-8"></div>
      </div>
    </div>
  </section>

  <div class="shell section grid gap-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,0.75fr)]">
    <div class="space-y-10 lg:col-start-1 lg:row-start-1">
      <section class="reveal">
        <h2 class="field-label">概述</h2>
        <p class="prose-block mt-4 text-base leading-8">{t.summary ?? '暂无摘要。'}</p>
      </section>

      {t.detail && (
        <section class="reveal">
          <h2 class="field-label">详细整理</h2>
          <div class="prose-block mt-4 text-base leading-8"><p>{t.detail}</p></div>
        </section>
      )}
    </div>

    <aside class="space-y-5 lg:col-start-2 lg:row-start-1">
      <div class="sticky-aside space-y-5">
        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">关系图</h2>
          {related.length === 0 ? (
            <p class="mt-3 text-sm text-muted">graph.json 中没有与该条目相连的边。</p>
          ) : (
            <ul class="mt-4 space-y-3 text-sm">
              {related.map((r) => (
                <li class="flex items-start justify-between gap-3">
                  <a href={entityHref(r.node.type, r.node.id)} class="link-underline text-[#d7dae1] hover:text-white">
                    {r.node.label ?? r.node.id}
                  </a>
                  <span class="chip shrink-0">{typeLabel[r.node.type ?? ''] ?? r.node.type ?? '关联'} · {r.type}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </aside>

    {textbook && (
      <div class="lg:col-span-2 lg:col-start-1 lg:row-start-2">
        <div class="mx-auto w-full max-w-5xl">
          <TheoryTextbook textbook={textbook} title={t.name} />
        </div>
      </div>
    )}

    <div class="space-y-10 lg:col-start-1 lg:row-start-3">
      <section>
        <h2 class="field-label">证据锚点（视频 + 时间码）</h2>
        {evidence.length === 0 ? (
          <div class="mt-4"><EmptyState title="暂无证据锚点" desc="该条目的 evidence 为空，等待流水线补充视频编号与时间码。" /></div>
        ) : (
          <ul class="mt-5 space-y-3">
            {evidence.map((e) => {
              const v = e.videoId ? videoById.get(e.videoId) : undefined;
              const href = '/videos/' + e.videoId + (typeof e.t === 'number' ? '?t=' + Math.floor(e.t) : '');
              return (
                <li class="card card-flat card-pad reveal flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                  <div class="min-w-0">
                    <a href={href} class="link-underline text-sm font-semibold text-[#e6e8ec] hover:text-white">
                      {v ? videoTitle(v) : '视频 ' + e.videoId}
                    </a>
                    {e.note && <p class="mt-1 text-xs text-muted">{e.note}</p>}
                  </div>
                  <div class="flex shrink-0 items-center gap-2">
                    <span class="chip mono">视频 {e.videoId}</span>
                    <span class="chip chip-accent mono">t = {formatTimecode(e.t)}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <section>
        <h2 class="field-label">相关视频</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          {videos.slice(0, 4).map((v) => <VideoCard video={v!} compact />)}
        </div>
        {videos.length === 0 && <div class="mt-4"><EmptyState title="暂无关联视频" /></div>}
      </section>
    </div>

    <aside class="space-y-5 lg:col-start-2 lg:row-start-3">
      <div class="sticky-aside space-y-5">
        <SourceList sources={t.sources} />
        <div class="card card-flat card-pad reveal">
          <h2 class="field-label">其他理论</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {theories.filter((x) => x.id !== t.id).slice(0, 6).map((x) => (
              <li><a href={'/theories/' + x.id} class="text-muted hover:text-white">{x.name ?? x.id}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
