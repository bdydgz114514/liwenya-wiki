---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatNumber, novelChapters, novelMeta, novelVolumeList } from '../../lib/data';
const totalChars = novelMeta.chars ?? 0;
---

<BaseLayout title="整本连读" description="《李文亚传》全书连读页：5 卷 30 章一次读完，便于打印与离线保存。" searchType="传记">
  <div class="shell section">
    <nav class="mono text-xs text-muted-dim">
      <a href="/novel" class="hover:text-white">长篇传记</a><span class="mx-2">/</span><span class="text-muted">整本连读</span>
    </nav>
    <header class="mt-6 border-b border-line pb-8">
      <span class="eyebrow">Full text</span>
      <h1 class="display-sm mt-4 text-shadow-hero">李文亚传</h1>
      <p class="mt-4 max-w-3xl text-sm leading-7 text-muted">
        一个花农与他的星空 · 全书 {novelChapters.length} 章约 {formatNumber(totalChars)} 字。
        本页为连读版，适合打印或另存；分章阅读请回「<a href="/novel" class="link-underline text-[#d7dae1]">目录</a>」。
      </p>
    </header>

    {novelVolumeList.map((v) => (
      <section class="mt-12">
        <h2 class="border-b border-line pb-2 text-lg font-extrabold tracking-tight">卷{v.no}　{v.title}</h2>
        {novelChapters.filter((c) => c.volume === v.no).map((c) => (
          <article class="novel-full mt-10">
            <h3 class="text-xl font-extrabold tracking-tight">
              <a href={'/novel/' + c.id} class="hover:text-accent">第{c.no}章　{c.title}</a>
            </h3>
            {c.epigraph && <p class="mt-3 border-l-2 border-accent/60 pl-4 text-sm text-muted">{c.epigraph}</p>}
            {(c.sections ?? []).map((s) => (
              <section class="mt-7">
                <h4 class="text-sm font-bold tracking-wide text-[#e9ebf0]">{s.title}</h4>
                {(s.paras ?? []).map((p) => <p>{p}</p>)}
              </section>
            ))}
          </article>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .novel-full p {
    margin-top: 1.1rem;
    font-size: 17px;
    line-height: 2.1;
    color: #d3d8e2;
    text-indent: 2em;
  }
</style>
